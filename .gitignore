/target
**/*.rs.bk
Cargo.lock.orig

# Data roots (never commit user data / test artifacts)
/data
/tmp

# Build/IDE
/.idea
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Generated protobuf bindings (produced by build.rs; schemas live in /protos)
**/src/proto_gen

# TS packages: dependencies and generated build output (src/ + lockfile reproduce them)
node_modules/
**/node_modules/
packages/naf-client-ts/dist/
packages/mcp-nai-lattice/dist/
/dist/

# Machine-specific MCP registry and local state (ship projects.example.json instead)
packages/mcp-nai-lattice/projects.json
packages/mcp-nai-lattice/state/

# Signing material: private keys and PFX passwords never enter git
.cert/
*.pfx
*.pfx.pwd
*.key

.env
.env.local

.kelvin-write-fence
.cargo