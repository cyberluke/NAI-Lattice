{
  "name": "@cyberluke/mcp-nai-lattice",
  "version": "0.1.0",
  "description": "NAI-Lattice MCP server: semantic code search over the local Qdrant index, plus the shared task ledger, mind-map feed and company policy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-nai-lattice": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "projects.example.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberluke/NAI-Lattice.git",
    "directory": "packages/mcp-nai-lattice"
  },
  "homepage": "https://github.com/cyberluke/NAI-Lattice#readme",
  "bugs": {
    "url": "https://github.com/cyberluke/NAI-Lattice/issues"
  },
  "keywords": [
    "nai",
    "lattice",
    "mcp",
    "semantic-search",
    "qdrant",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cyberluke/nai-lattice-client": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
